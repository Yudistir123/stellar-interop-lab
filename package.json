{
  "name": "stellar-interop-lab",
  "version": "0.1.0",
  "description": "Deterministic interoperability conformance fixtures and test runner for Stellar SEP specifications",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "interop-lab": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run clean && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "example": "node --experimental-strip-types examples/run-basic.ts"
  },
  "keywords": [
    "stellar",
    "soroban",
    "sep",
    "interoperability",
    "conformance",
    "testing"
  ],
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
